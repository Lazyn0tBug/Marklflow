node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Local test evidence
playwright-report/
test-results/
.aistudio/

# 本机的工作稿：不入库（曾被一次 git add -A 卷进来）。
# 只挡 tests/ 根下的 docx；tests/fixtures/ 里的验收样例是入库证据，不受影响。
tests/*.docx

# 运行期日志：当前目录下的 log 子目录，不入库。
log/

# Tauri generated build output; Cargo.lock remains tracked.
src-tauri/target/
src-tauri/gen/

# Staged desktop CI bundles and artifact manifests.
desktop-artifacts/

# 代码知识图谱：本地 SQLite 库，含绝对路径与结构元数据，不入库。
# （工具自己也会在目录里放一份 .gitignore，这里再挡一道，让意图对读仓库的人也是显式的。）
.code-review-graph/
# ctxguard：外部工具（读取纪律的执行者），不属于本仓库 ⇒ ⇒ 连源码一起挡掉，
# 免得一次 `git add -A` 就把它卷进来。
.ctxindex/
.claude/ctxguard/

# 截图是测试产物 ✓ ⇒ ⇒ 不入库 ✓；要留证据，就把**结论**写进文档 ✓。
docs/acceptance/**/*.png
