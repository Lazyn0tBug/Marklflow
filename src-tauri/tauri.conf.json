{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFlow",
  "version": "0.9.1",
  "identifier": "com.markflow.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkFlow 墨流 - Markdown 排版与发布工作台",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "开箱即用、支持公式与图表、具备流式与 A4 分页预览、支持原生 DOCX 与 PDF 导出的专业 Markdown 编辑工作台",
    "longDescription": "MarkFlow (墨流) 是一款专业级现代 Markdown 排版与文档发布工作台。支持公式、架构图、A4 分页仿真及多端原生导出。"
  }
}
