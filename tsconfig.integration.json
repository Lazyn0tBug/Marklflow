{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "/src/*": ["./src/*"]
    }
  },
  "include": [
    "tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/types/strict-contracts.ts",
    "scripts/measure-architecture-baseline.ts",
    "scripts/pdf-probe-sample.ts",
    "src/types/**/*.d.ts",
    "tests/fixtures/architecture/worker-probe-client.ts",
    "tests/fixtures/architecture/markdown-worker-probe-client.ts",
    "tests/fixtures/architecture/dual-worker-probe-client.ts",
    "tests/fixtures/architecture/shared-dom-probe-client.ts",
    "tests/fixtures/architecture/math-dom-probe-client.ts",
    "tests/fixtures/architecture/math-omml-probe-client.ts",
    "tests/fixtures/architecture/export-html-probe-client.ts",
    "tests/fixtures/architecture/web-native-pdf-probe-client.ts",
    "tests/fixtures/architecture/diagram-dom-probe-client.ts",
    "tests/fixtures/architecture/pagination-dom-probe-client.ts",
    "tests/fixtures/architecture/pdf-probe-client.ts",
    "tests/fixtures/architecture/tauri-native-io-probe-client.ts",
    "tests/fixtures/architecture/tauri-native-io-probe-report.ts",
    "tests/fixtures/architecture/react-error-probe-client.ts",
    "tests/fixtures/messages/messages-component-sample-client.tsx",
    "tests/fixtures/messages/message-lifecycle-client.tsx"
  ]
}
