{
  "version": 1,
  "scope": "\u4e24\u7aef\u5404\u81ea\u7684\u8bfb\u7aef\u53e3\u5bf9\u540c\u4e00\u6279\u5b57\u8282\u7ed9\u51fa\u540c\u4e00\u4e2a\u7ed3\u679c\uff1a\u6587\u672c\u5c31\u662f\u540c\u4e00\u6bb5\u6587\u672c\uff0c\u51fa\u9519\u5c31\u662f\u540c\u4e00\u4e2a\u673a\u5668\u7801 \u21d2 \u5e94\u7528\u53ea\u8ba4\u6807\u8bc6\u3001\u4e0d\u95ee\u6765\u6e90 \u21d2 \u8fd9\u662f\u300c\u540c\u4e00\u4ef6\u4e8b\u540c\u4e00\u4e2a\u6807\u8bc6\u300d\u5728\u884c\u4e3a\u5c42\u7684\u9a8c\u6536\u57fa\u51c6\uff08\u00a79\uff09\u3002",
  "covers": "\u53ea\u8986\u76d6\u4e24\u7aef\u5404\u81ea\u5b9e\u73b0\u7684\u90a3\u51e0\u6761\uff1a\u4e25\u683c UTF-8 \u4e0e\u5265 BOM\u3002\u5171\u7528\u6279\u6b21\u91cc\u7684\u89c4\u5219\uff08NUL\u3001\u6269\u5c55\u540d\u3001\u6e90\u6587\u4e0a\u9650\u3001schema\u3001\u8d44\u4ea7\uff09\u53ea\u6709\u4e00\u4efd\u5b9e\u73b0\uff0c\u4e0d\u5728\u8fd9\u91cc\uff1b\u5b57\u8282\u4e0a\u9650\u90a3\u4e2a\u6570\u5b57\u53e6\u7b97\uff08\u653e\u4e0d\u8fdb\u6837\u672c\uff09\u3002",
  "limits": {
    "importBytes": 52428800,
    "nativeWriteBytes": 104857600,
    "note": "\u4e24\u7aef\u523b\u610f\u4e00\u81f4\u7684\u4e24\u4e2a\u4e0a\u9650\uff1a\u5bfc\u5165\u7684\u5b57\u8282\u4e0a\u9650\u4e0e\u539f\u751f\u5199\u5165\u7684\u5b57\u8282\u4e0a\u9650\u3002\u539f\u751f\u4fa7\u5404\u6709\u4e00\u4efd\u5e38\u91cf\uff08files.rs \u7684 READ_LIMIT / WRITE_LIMIT\uff09\uff0c\u7531 scripts/check-file-limits.ts \u76ef\u4f4f\u4e0e\u8fd9\u91cc\u76f8\u7b49\u3002"
  },
  "cases": [
