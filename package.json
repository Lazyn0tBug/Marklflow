{
  "name": "react-example",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:desktop": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "tauri": "tauri",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "bun run check:source && bun run check:boundaries && oxlint --deny-warnings .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.integration.json && bun run check:type-coverage",
    "check:source": "bun scripts/check-source-policy.ts",
    "check:boundaries": "bun scripts/check-module-boundaries.ts",
    "check:type-coverage": "bun scripts/check-type-coverage.ts",
    "check:architecture-baseline": "bun scripts/check-architecture-baseline.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@vitejs/plugin-react": "^6.1.1",
    "css-tree": "3.2.1",
    "decode-named-character-reference": "1.3.0",
    "docx": "^9.14.0",
    "dompurify": "3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-type": "22.2.0",
    "filenamify": "7.0.3",
    "hash.js": "1.1.7",
    "jszip": "3.10.2",
    "lucide-react": "^0.546.0",
    "mathjax": "3.2.2",
    "mermaid": "^12.2.0",
    "motion": "^12.23.24",
    "pagedjs": "0.4.3",
    "parse5": "7.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "^8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/css-tree": "3.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
